<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks the mod's XML defs against the game's real classes the way RimWorld's XML loader does (field names, LoadAlias,
    Class attributes, <li> lists, enums, Type names, def references). Reads assemblies with MetadataLoadContext only;
    no game code is executed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.13" />
  </ItemGroup>

</Project>
